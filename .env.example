# Service
QUANSTATE_DATA_DIR=./api/data/runtime
QUANSTATE_CORS_ORIGINS=*
QUANSTATE_STT=none                 # none | auto | faster-whisper | http | scripted
QUANSTATE_WHISPER_MODEL=tiny        # or /models/faster-whisper-small
# QUANSTATE_STT_HTTP_URL=http://localhost:9000/v1/audio/transcriptions
QUANSTATE_TRANSLATOR=auto           # auto | memory | nllb | http
# QUANSTATE_TRANSLATE_HTTP_URL=http://localhost:5000
QUANSTATE_TTS=auto                  # auto | tone | piper
# QUANSTATE_PIPER_VOICES=/models/piper
QUANSTATE_FAST_PATH_MS=5
QUANSTATE_E2E_MS=100
# QUANSTATE_CA_BUNDLE=/etc/ssl/certs/corporate-ca.pem

# Web / mobile
# VITE_API_URL=http://127.0.0.1:8000
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8000
