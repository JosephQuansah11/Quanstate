{
  "name": "expo-audio",
  "version": "58.0.10",
  "description": "A cross-platform audio library for React Native and Expo apps.",
  "keywords": [
    "android",
    "audio",
    "expo",
    "expo-audio",
    "ios",
    "react-native"
  ],
  "homepage": "https://docs.expo.dev/versions/latest/sdk/audio/",
  "license": "MIT",
  "author": "650 Industries, Inc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/expo/expo.git",
    "directory": "packages/expo-audio"
  },
  "sideEffects": false,
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "devDependencies": {
    "@expo/internal-scripts": "58.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "~19.3.0",
    "expo": "58.0.17",
    "expo-asset": "58.0.18"
  },
  "peerDependencies": {
    "expo": "*",
    "expo-asset": "*",
    "react": "*",
    "react-native": "*"
  },
  "jest": {
    "preset": "@expo/internal-scripts"
  },
  "title": "Expo Audio",
  "scripts": {
    "precompile-android": "et prebuild-android-package-for-publish",
    "build": "pnpm run build:lib && pnpm run build:plugin",
    "build:lib": "expo-build src",
    "build:plugin": "expo-build --base plugin cjs:src",
    "clean": "expo-module clean",
    "lint": "oxlint --config oxlint.config.mjs .",
    "test": "jest",
    "format": "expo-module format",
    "depscheck": "expo-module depscheck",
    "typecheck": "tsc -b tsconfig.all.json"
  }
}