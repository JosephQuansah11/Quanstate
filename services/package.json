{
  "name": "@quanstate/services",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared realtime translation, speech and learning services for web, iOS and Android",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "^24.10.1",
    "vitest": "5.0.5"
  }
}
